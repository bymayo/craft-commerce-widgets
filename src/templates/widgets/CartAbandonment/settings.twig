{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\commercewidgets\\assetbundles\\commercewidgets\\CommerceWidgetsAsset") %}

{{
   forms.selectField(
      {
         label: 'Target Duration',
         id: 'targetDuration',
         name: 'targetDuration',
         value: widget['targetDuration'],
         options: [
            { label: 'Plugin Default', value: 'default' },
            { label: 'Daily', value: 'daily' },
            { label: 'Weekly', value: 'weekly' },
            { label: 'Monthly', value: 'monthly' },
            { label: 'Yearly', value: 'yearly' },
            { label: 'Fiscal Year', value: 'fiscalYear' }
         ]
      }
   )
}}

{{
   forms.textField(
      {
         label: 'Previous Amount',
         id: 'previousAmount',
         instructions: 'The amount of the previous period. E.g. 6 would show the previous 5 months.',
         name: 'previousAmount',
         value: widget['previousAmount']
      }
   )
}}

{{
   forms.textField(
      {
         label: 'Graph Step',
         id: 'graphStep',
         name: 'graphStep',
         value: widget['graphStep']
      }
   )
}}

{{
   forms.selectField(
      {
         label: 'Graph Style',
         id: 'graphStyle',
         name: 'graphStyle',
         value: widget['graphStyle'],
         options: [
            { label: 'Detailed', value: 'detailed' },
            { label: 'Simple', value: 'simple' }
         ]
      }
   )
}}
