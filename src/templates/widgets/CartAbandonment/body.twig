{% extends 'commerce-widgets/layout' %}

{% block widget %}

  {% set dataCountTotal = abandonedTotal.count + completedTotal.count %}

  <div class="cw:flex cw:gap-2 cw:mb-10">

    <div class="cw:w-1/2">

      {% include 'commerce-widgets/_includes/statistic' with {
        heading: 'Completed',
        statistic: completedTotal.count|number_format(),
        statisticSecondary: completedTotal.totalPrice|currency(commerce.currency),
        changeIndicator: completedChange.percentage,
        changeDirection: completedChange.direction,
        changeTooltip: changeTooltip
      } only %}

    </div>

    <div class="cw:w-1/2">

      {% include 'commerce-widgets/_includes/statistic' with {
        heading: 'Abandoned',
        statistic: abandonedTotal.count|number_format(),
        statisticSecondary: abandonedTotal.totalPrice|currency(commerce.currency),
        changeIndicator: abandonedChange.percentage,
        changeDirection: abandonedChange.direction,
        changeTooltip: changeTooltip
      } only %}

    </div>

  </div>

  <div class="{{ graphStyle == 'simple' ? 'cw:-ml-7 cw:-mr-7.5' }}">
    {% include 'commerce-widgets/_includes/charts/line' with {
      id: widgetId,
      step: graphStep,
      style: graphStyle,
      labels: labels,
      primaryLabel: 'Completed',
      primaryData: completedChart,
      secondaryLabel: 'Abandoned',
      secondaryData: abandonedChart
    } only %}
  </div>

{% endblock %}
