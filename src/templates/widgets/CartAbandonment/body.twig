{% extends 'commerce-widgets/layout' %}

{% block widget %}

  {% set dataCountTotal = abandonedCartData.count + completedCartData.count %}

  <div class="cw:flex cw:gap-2 cw:mb-10">

    <div class="cw:w-1/2">

      {% include 'commerce-widgets/_includes/statistic' with { 
        heading: 'Completed',
        statistic: completedCartData.count|number_format(),
        statisticSecondary: completedCartData.totalPrice|currency(commerce.currency),
        changeIndicator: '3%',
        changeDirection: 'up'
      } %}

    </div>

    <div class="cw:w-1/2">

      {% include 'commerce-widgets/_includes/statistic' with { 
        heading: 'Abandoned',
        statistic: abandonedCartData.count|number_format(),
        statisticSecondary: abandonedCartData.totalPrice|currency(commerce.currency),
        changeIndicator: '5%',
        changeDirection: 'down',
      } only %}

    </div>

  </div>

  <div class="{{ graphStyle == 'simple' ? 'cw:-ml-7 cw:-mr-7.5' }}">
    {% include 'commerce-widgets/_includes/charts/line' with {
      id: 'cart-abandonment',
      step: graphStep,
      style: graphStyle
    } only %}
  </div>

  {% include 'commerce-widgets/_includes/footer' with {
    buttons: [
      {
        text: 'Export',
        url: '/' ~ cpTrigger ~ '/commerce/orders'
      }
    ]
  } only %}

{% endblock %}
