{% extends 'commerce-widgets/layout' %}

{% block widget %}

   <div class="cw:-ml-6 cw:-mr-6">

      {% include 'commerce-widgets/_includes/charts/progress' with { 
         total: total,
         totalFormatted: type == 'orders' ? total|number_format() : total|currency(commerce.currency),
         target: targetValue,
         targetFormatted: type == 'orders' ? targetValue|number_format() : targetValue|currency(commerce.currency),
         style: 'blue',
      } only %}
      
   </div>

{% endblock %}
