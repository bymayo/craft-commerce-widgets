{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\commercewidgets\\assetbundles\\commercewidgets\\CommerceWidgetsAsset") %}

{% include 'commerce-widgets/_includes/settings/orderStatus' with {
   orderStatuses: orderStatuses,
   value: widget['orderStatusId']
} only %}

{{
   forms.selectField(
      {
         label: 'Order By',
         name: 'orderBy',
         value: widget['orderBy'],
         options: [
            { label: 'Ordered Total', value: 'totalOrdered' },
            { label: 'Revenue Total', value: 'totalRevenue' }
         ]
      }
   )
}}

{% include 'commerce-widgets/_includes/settings/limit' with {
   value: widget['limit']
} only %}

{% include 'commerce-widgets/_includes/settings/targetDuration' with {
   value: widget['targetDuration']
} only %}