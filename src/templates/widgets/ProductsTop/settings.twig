{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\commercewidgets\\assetbundles\\commercewidgets\\CommerceWidgetsAsset") %}

{% set orderStatusOptions = [{ label: 'All', value: '' }] %}
{% for status in orderStatuses %}
   {% set orderStatusOptions = orderStatusOptions|merge([{ label: status.name, value: status.id }]) %}
{% endfor %}

{{
   forms.selectField(
      {
         label: 'Order Status',
         name: 'orderStatusId',
         value: widget['orderStatusId'],
         options: orderStatusOptions
      }
   )
}}

{{
   forms.selectField(
      {
         label: 'Order By',
         name: 'orderBy',
         value: widget['orderBy'],
         options: [
            { label: 'Ordered Total', value: 'totalOrdered' },
            { label: 'Revenue Total', value: 'totalRevenue' }
         ]
      }
   )
}}

{{
   forms.textField(
      {
         label: 'Limit',
         id: 'limit',
         name: 'limit',
         value: widget['limit']
      }
   )
}}

{{
   forms.selectField(
      {
         label: 'Target Duration',
         id: 'targetDuration',
         name: 'targetDuration',
         value: widget['targetDuration'],
         options: [
            { label: 'Plugin Default', value: 'default' },
            { label: 'Daily', value: 'daily' },
            { label: 'Weekly', value: 'weekly' },
            { label: 'Monthly', value: 'monthly' },
            { label: 'Yearly', value: 'yearly' },
            { label: 'Fiscal Year', value: 'fiscalYear' },
            { label: 'All Time', value: 'allTime' }
         ]
      }
   )
}}
