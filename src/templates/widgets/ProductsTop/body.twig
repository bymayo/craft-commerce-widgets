{% extends 'commerce-widgets/layout' %}

{% block widget %}

   <div class="cw:-ml-6 cw:-mr-6">

         {% for product in products %}

            {% set element = craft.products.id(product.id).status(null).one() %}

            <div class="{{ not loop.first ? 'cw:border-t! cw:border-gray-100 cw:border-solid' }} {{ loop.first ? 'cw:pb-3' }} {{ loop.last ? 'cw:pt-3' }} {{ not loop.last and not loop.first ? 'cw:py-3' }}">

               <div class="cw:flex cw:px-6">

                  <div class="cw:flex cw:items-center cw:w-9/12">

                     <a href="{{ element.cpEditUrl }}" class="cw:w-14 cw:h-14 cw:flex cw:items-center cw:justify-center cw:rounded cw:overflow-hidden cw:border! cw:border-gray-200 cw:border-solid cw:mr-2 cw:bg-gray-50 cw:flex-shrink-0">
                        {{ element.getThumbHtml(100)|raw }}
                     </a>

                     <div class="cw:w-full cw:pr-10">
                     
                        <a href="{{ element.cpEditUrl }}" class="cw:max-w-[90%] cw:inline-block cw:font-semibold cw:mb-0.5 cw:truncate">
                           {{ element.title }}
                        </a>

                        <div class="cw:w-full">
                           {% include 'commerce-widgets/_includes/sku' with {
                              sku: product.sku
                           } only %}
                        </div>

                     </div>

                  </div>

                  <div class="cw:pl-4">
                     {% include 'commerce-widgets/_includes/statistic' with { 
                        statistic: product.totalOrdered|number_format(),
                        statisticSecondary: product.totalRevenue|currency(commerce.currency),
                        changeIndicator: '5%',
                        changeDirection: 'down',
                        padding: false,
                        border: false 
                     } only %}
                  </div> 

               </div>
                
            </div>

         {% endfor %}

   </div>

   {% include 'commerce-widgets/_includes/footer' with {
      buttons: [
         {
            text: 'View All Products',
            url: '/' ~ cpTrigger ~ '/commerce/products'
         },
         {
            text: 'Export',
            url: '/' ~ cpTrigger ~ '/commerce/export'
         }
      ]
   } only %}

   {% set rankClasses = ['-first', '-second', '-third'] %}

   {# <table class="data fullwidth collapsible">
      <thead>
         <tr>
            <th colspan="2">Product</th>
            <th>Total Revenue</th>
            <th>Total Orders</th>
         </tr>
      </thead>
      <tbody>
         {% for product in products %}

            {% set element = craft.products.id(product.id).status(null).one() %}
            
            <tr{% if loop.first %} class="rank-background -first"{% endif %}>
               <td class="rank-column">
                  <span class="rank {{ rankClasses[loop.index0] is defined ? rankClasses[loop.index0] }}">
                     {% if loop.first %}
                        <i class="fas fa-crown"></i>
                     {% else %}
                        {{ loop.index}}
                     {% endif %}
                  </span>
               </td>
               <td>
                  <div class="element hasstatus">
                     <span class="status {{ element.status }}"></span>
                     <div class="label">
                        <span class="title">
                           <a href="{{ element.cpEditUrl }}">
                              {{ element.title|length > 40 ? element.title|slice(0, 40) ~ '...' : element.title }}
                           </a>
                        </span>
                     </div>
                  </div>
               </td>
               <td>{{ product.totalRevenue|currency(commerce.currency) }}</td>
               <td>{{ product.totalOrdered|number_format() }}</td>
            </tr>
         {% else %}
            <tr>
               <td colspan="5">
                  No products found.
               </td>
            </tr>
         {% endfor %}
      </tbody>
   </table>

   <a href="/{{ cpTrigger }}/commerce/products" class="btn">View All Products</a> #}

{% endblock %}
