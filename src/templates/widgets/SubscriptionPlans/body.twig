{% extends 'commerce-widgets/layout' %}

{% block widget %}

   <div class="tableview cw:pt-6">

      <div class="tablepane">

         <table class="data fullwidth">
            <thead>
               <tr>
                  <th>Plan</th>
                  <th>Active Subscriptions</th>
               </tr>
            </thead>
            <tbody>
               {% for plan in plans %}
                  <tr>
                     <td>
                        <div class="element hasstatus cw:flex cw:items-center">
                           <span class="status {{ plan.enabled|default(false) ? 'live' : 'disabled' }}"></span>
                           <a href="/{{ cpTrigger }}/commerce/subscriptions?planId={{ plan.id }}" class="cw:font-semibold">
                              {{ plan.name }}
                           </a>
                        </div>
                     </td>
                     <td>{{ plan.activeSubscriptions|number_format() }}</td>
                  </tr>
               {% else %} 
                  <tr>
                     <td colspan="2">
                        No subscriptions found.
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>

      </div>

   </div>

   {% include 'commerce-widgets/_includes/footer' with {
      buttons: [
         {
            text: 'View All Subscription Plans',
            url: '/' ~ cpTrigger ~ '/commerce/subscription-plans'
         }
      ]
   } only %}

{% endblock %}
