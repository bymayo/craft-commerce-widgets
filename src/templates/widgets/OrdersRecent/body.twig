{% extends 'commerce-widgets/layout' %}

{% block widget %}

   <div class="tableview cw:pt-6">

      <div class="tablepane">

         <table class="data fullwidth">
            <thead>
               <tr>
                  <th>Order</th>
                  <th>Total Paid</th>
                  <th>Date Paid</th>
               </tr>
            </thead>
            <tbody>
               {% for order in orders %}
                  <tr>
                     <td>
                        <div class="element hasstatus cw:flex cw:items-center">
                           <span class="status {{ order.orderStatus.color|default('') }}"></span>
                           {# <span class="cw:mr-2">
                              {{ order.orderStatus.labelHtml|raw }} 
                           </span> #}
                           <a href="{{ order.cpEditUrl }}" class="cw:font-semibold">
                              {{ order.shortNumber }}
                           </a>
                        </div>
                     </td>
                     <td>
                        {{ order.totalPaid|currency(order.currency) }}
                     </td>
                     <td>{{ order.datePaid|datetime('short') }}</td>
                  </tr>
               {% else %}
                  <tr>
                     <td colspan="3">
                        No orders found.
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>

      </div>

   </div>

   {% include 'commerce-widgets/_includes/footer' with {
      buttons: [
         {
         text: 'View All Orders',
         url: '/' ~ cpTrigger ~ '/commerce/orders'
         }
      ]
   } only %}

{% endblock %}
