{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\commercewidgets\\assetbundles\\commercewidgets\\CommerceWidgetsAsset") %}

{{
   forms.selectField(
      {
         label: 'Order By',
         name: 'orderBy',
         value: widget['orderBy'],
         options: [
            { label: 'Order Total', value: 'totalOrders' },
            { label: 'Revenue Total', value: 'totalRevenue' }
         ]
      }
   )
}}

{{
   forms.lightswitchField(
      {
         label: 'Include Guest Customers',
         id: 'includeGuests',
         name: 'includeGuests',
         on: widget['includeGuests']
      }
   )
}}

{{
   forms.textField(
      {
         label: 'Limit',
         id: 'limit',
         name: 'limit',
         value: widget['limit']
      }
   )
}}

{{
   forms.selectField(
      {
         label: 'Target Duration',
         id: 'targetDuration',
         name: 'targetDuration',
         value: widget['targetDuration'],
         options: [
            { label: 'Plugin Default', value: 'default' },
            { label: 'Daily', value: 'daily' },
            { label: 'Weekly', value: 'weekly' },
            { label: 'Monthly', value: 'monthly' },
            { label: 'Yearly', value: 'yearly' },
            { label: 'Fiscal Year', value: 'fiscalYear' },
            { label: 'All Time', value: 'allTime' }
         ]
      }
   )
}}

{{
   forms.lightswitchField(
      {
         label: 'Exclude Admins',
         id: 'excludeAdmins',
         name: 'excludeAdmins',
         on: widget['excludeAdmins']
      }
   )
}}
