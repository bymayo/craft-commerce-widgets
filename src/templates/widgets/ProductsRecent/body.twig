{% extends 'commerce-widgets/layout' %}

{% block widget %}

   <div class="tableview cw:pt-6">

      <div class="tablepane">

         <table class="data fullwidth">
            <thead>
               <tr>
                  <th>Product</th>
                  <th>SKU</th>
                  <th>Price</th>
               </tr>
            </thead>
            <tbody>
               {% for product in products %}
                  <tr>
                     <td>
                        <div class="element hasstatus cw:flex cw:items-center">
                           <span class="status {{ product.status }}"></span>
                           <a href="{{ product.cpEditUrl }}" class="cw:font-semibold">
                              {{ product.title|length > 40 ? product.title|slice(0, 40) ~ '...' : product.title }}
                           </a>
                        </div>
                     </td>
                     <td>
                        {% include 'commerce-widgets/_includes/sku' with {
                           sku: product.defaultSku|default('--')
                        } only %}
                     </td>
                     <td>{{ product.defaultPrice is not null ? product.defaultPrice|currency(commerce.currency) : '--' }}</td>
                  </tr>
               {% else %}
                  <tr>
                     <td colspan="3">
                        No products found.
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>

      </div>

   </div>

   {% include 'commerce-widgets/_includes/footer' with {
      buttons: [
         {
         text: 'View All Products',
         url: '/' ~ cpTrigger ~ '/commerce/products'
         }
      ]
   } only %}

{% endblock %}
