{% extends 'commerce-widgets/layout' %}

{% block widget %}

  <div class="cw:grid cw:grid-cols-2 cw:flex-wrap cw:gap-2">

   {% for row in revenueOrders %}

    <div class="cw:col-span-1">

      {% include 'commerce-widgets/_includes/statistic' with {
        heading: timeFrames[loop.index0]['label'],
        statistic: row.totalOrders|number_format(),
        statisticSecondary: row.totalRevenue|currency(commerce.currency),
        changeIndicator: row.changeIndicator,
        changeDirection: row.changeDirection
      } %}

    </div>

   {% endfor %}

  </div>

  {% include 'commerce-widgets/_includes/footer' with {
    buttons: [
      {
        text: 'View All Orders',
        url: '/' ~ cpTrigger ~ '/commerce/orders'
      }
    ]
  } only %}

{% endblock %}

