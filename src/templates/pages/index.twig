{% extends "_layouts/cp" %}

{% set title = activePage.name %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = selectedSubnavItem %}

{% css %}
  #content-container { background: none !important; }
  #main-content #content { padding: 0 !important; background: none !important; border: none !important; box-shadow: none !important; }
{% endcss %}

{% block actionButton %}
  <div class="btngroup">
    <button type="button" class="btn menubtn" id="cw-add-widget-btn">Add Widget</button>
    <div class="menu">
      <ul>
        {% for widgetType in availableTypes %}
          <li>
            <a href="#" data-type="{{ widgetType.class }}">{{ widgetType.name }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  {% if enablePages and canManagePages %}
    <button type="button" class="btn" id="cw-add-page" style="margin-left: 1px;">Add Page</button>

    <div class="btngroup" style="margin-left: 1px;">
      <button type="button" class="btn menubtn icon" id="cw-page-menu-btn" title="Page Settings">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" style="display: block;"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
      </button>
      <div class="menu">
        <ul>
          <li><a href="#" id="cw-rename-page">Rename Page</a></li>
          {% if pages|length > 1 %}
            <li><a href="#" id="cw-delete-page" class="error">Delete Page</a></li>
          {% endif %}
        </ul>
      </div>
    </div>
  {% endif %}
{% endblock %}

{% block content %}

  <div id="cw-dashboard-grid"
       class="commerce-widgets"
       data-page-id="{{ activePage.id }}">

    <div class="cw-grid-sizer"></div>
    <div class="cw-gutter-sizer"></div>

    {% for widget in widgets %}
      {% include 'commerce-widgets/pages/_widget' with { widget: widget } only %}
    {% endfor %}

  </div>

  {% if cachedAt %}
    <p style="text-align: center; margin-top: 24px; color: var(--gray-500); font-size: 11px;">
      Data last refreshed {{ cachedAt|datetime('short') }}
    </p>
  {% endif %}

{% endblock %}
