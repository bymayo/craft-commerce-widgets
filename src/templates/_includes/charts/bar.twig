{% set previousValue = previousValue ?? 0 %}
{% set currentValue = currentValue ?? 0 %}
{% set previousLabel = previousLabel ?? 'Previous' %}
{% set currentLabel = currentLabel ?? 'Current' %}

<div class="cw:w-full cw:h-72">
    <canvas id="chart-bar-{{ id }}" class="cw:w-full cw:h-full"></canvas>
</div>

{% js %}

    (function() {
        const style = window.getComputedStyle(document.body);

        const cwChartElement = document.getElementById('chart-bar-{{ id }}').getContext('2d');

        const data = {
            labels: [''],
            datasets: [
                {
                    label: '{{ previousLabel }}',
                    data: [{{ previousValue }}],
                    pointBackgroundColor: style.getPropertyValue('--cw-color-blue-500'),
                    fill: 'start',
                    pointRadius: 0,
                    backgroundColor: style.getPropertyValue('--cw-color-blue-100'),
                    barPercentage: 1.0,
                    categoryPercentage: 1.0
                },
                {
                    label: '{{ currentLabel }}',
                    data: [{{ currentValue }}],
                    pointRadius: 0,
                    pointBackgroundColor: style.getPropertyValue('--cw-color-blue-300'),
                    borderColor: style.getPropertyValue('--cw-color-blue-300'),
                    backgroundColor: style.getPropertyValue('--cw-color-blue-500'),
                    barPercentage: 1.0,
                    categoryPercentage: 1.0
                }
            ]
        };

        const config = {
            type: 'bar',
            data: data,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'nearest'
                },
                layout: {
                    padding: {
                        top: 0,
                        right: 0,
                        bottom: -5,
                        left: -7
                    }
                },
                plugins: {
                    tooltip: {
                        padding: 8,
                        xAlign: 'center',
                        yAlign: 'bottom',
                        cornerRadius: 5
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            display: false,
                            drawBorder: false
                        },
                        grid: {
                            display: false
                        },
                        border: {
                            display: false
                        }
                    },
                    y: {
                        ticks: {
                            display: false,
                            drawBorder: false,
                        },
                        grid: {
                            display: false
                        },
                        border: {
                            display: false
                        }
                    }
                }
            }
        };

        new CwChart(cwChartElement, config);
    })();

{% endjs %}