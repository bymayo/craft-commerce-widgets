<canvas id="chart-line-{{ id }}" class="cw:h-80 cw:w-full"></canvas>

{% js %}

const style = window.getComputedStyle(document.body);

const ctx = document.getElementById('chart-line-{{ id }}').getContext("2d");

var gradient = ctx.createLinearGradient(0, 0, 0, ctx.canvas.height * 2);
gradient.addColorStop(0, opacify(convert(style.getPropertyValue('--cw-color-blue-500'), 'rgba'), 0.9));
gradient.addColorStop(1, opacify(convert(style.getPropertyValue('--cw-color-blue-300'), 'rgba'), 0.2));

const data = {
    labels: ['February', 'March', 'April', 'May'],
    datasets: [
    {
      label: 'Completed',
      data: [5, 92, 18, 90],
      lineTension: 0.3,
      pointBackgroundColor: style.getPropertyValue('--cw-color-blue-500'),
      borderColor: style.getPropertyValue('--cw-color-blue-500'),
      fill: 'start',
      pointRadius: 3,
      backgroundColor: gradient
    },
    {
      label: 'Abandoned',
      data: [0, 40, 12, 150],
      lineTension: 0.3,
      borderDash: [4,3],
      pointBackgroundColor: style.getPropertyValue('--cw-color-blue-300'),
      borderColor: style.getPropertyValue('--cw-color-blue-300'),
      backgroundColor: 'transparent'
    }
  ]
}

console.log(style.getPropertyValue('--cw-color-blue-300'));

const config = {
    type: 'line',
    data: data,
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom',
                labels: {
                    boxWidth: 20,
                    boxHeight: 6,
                    useBorderRadius: true,
                    borderRadius: 1
                }
            }
        },
        scales: {
            x: {
                grid: {
                    display: false
                }
            },
            y: {
                ticks: {
                    backdropColor: 'rgba(0, 0, 0, 0)',
                    stepSize: 50
                },
                grid: {
                    display: true,
                    color: style.getPropertyValue('--cw-color-gray-200'),
                }
            }
        }
    }
}

const chart = new CwChart(ctx, config);

