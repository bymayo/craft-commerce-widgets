<div class="cw:w-full cw:h-80">
    <canvas id="chart-line-{{ id }}" class="cw:w-full cw:h-full"></canvas>
</div>


{% js %}

    const style = window.getComputedStyle(document.body);

    const cwChartElement = document.getElementById('chart-line-{{ id }}').getContext('2d');

    var gradient = cwChartElement.createLinearGradient(0, 0, 0, cwChartElement.canvas.height * 2);
    gradient.addColorStop(0, opacify(convert(style.getPropertyValue('--cw-color-blue-500'), 'rgba'), 0.9));
    gradient.addColorStop(1, opacify(convert(style.getPropertyValue('--cw-color-blue-300'), 'rgba'), 0.2));

    const data = {
        labels: ['February', 'March', 'April', 'May'],
        datasets: [
        {
            label: 'Completed',
            data: [5, 92, 18, 90],
            lineTension: 0.3,
            pointBackgroundColor: style.getPropertyValue('--cw-color-blue-500'),
            borderColor: style.getPropertyValue('--cw-color-blue-500'),
            fill: 'start',
            pointRadius: 3,
            backgroundColor: gradient
        },
        {
            label: 'Abandoned',
            data: [0, 40, 12, 150],
            lineTension: 0.3,
            borderDash: [4,3],
            pointBackgroundColor: style.getPropertyValue('--cw-color-blue-300'),
            borderColor: style.getPropertyValue('--cw-color-blue-300'),
            backgroundColor: 'transparent'
        }
    ]
    }

    const config = {
        type: 'line',
        data: data,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'nearest'
            },
            layout: {
                padding: {
                    top: 0,
                    right: -3,
                    bottom: 0,
                    left: -6 
                }
            },
            plugins: {
                tooltip: {
                    padding: 8,
                    xAlign: 'center',
                    yAlign: 'top',
                    cornerRadius: 5
                },
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 20,
                        boxHeight: 6,
                        useBorderRadius: true,
                        borderRadius: 1
                    }
                }
            },
            scales: {
                x: {
                    ticks: {
                        display: {{ style == 'detailed' ? 'true' : 'false' }},
                        align: 'inner',
                    },
                    grid: {
                        display: false
                    }
                },
                y: {
                    ticks: {
                        display: {{ style == 'detailed' ? 'true' : 'false' }},
                        backdropColor: 'rgba(0, 0, 0, 0)',
                        stepSize: {{ step }},
                        drawBorder: false
                    },
                    grid: {
                        display: {{ style == 'detailed' ? 'true' : 'false' }},
                        color: style.getPropertyValue('--cw-color-gray-200'),
                    },
                    border: {
                        display: {{ style == 'detailed' ? 'true' : 'false' }},
                    }
                }
            }
        }
    }

    const chart = new CwChart(cwChartElement, config);

